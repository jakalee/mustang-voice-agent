# Mustang AI 설정 파일 예시
# 이 파일을 복사해서 config/.env 로 저장하고 값을 채워주세요

# Gmail (앱 비밀번호 - Google 계정 > 보안 > 앱 비밀번호)
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 텔레그램 봇 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Drive 로컬 폴더 경로 (Google Drive 앱 설치 시)
GOOGLE_DRIVE_PATH=/Users/yourname/Library/CloudStorage/GoogleDrive-your@gmail.com

# Picovoice 웨이크워드 (https://console.picovoice.ai 에서 발급)
PICOVOICE_ACCESS_KEY=your_picovoice_key
KEYWORD_PATH=/path/to/your_wakeword_ko_mac.ppn
KO_MODEL_PATH=/path/to/porcupine_params_ko.pv

# Mustang AI 설정 파일 예시
# 이 파일을 복사해서 config/.env 로 저장하고 값을 채워주세요
# cp config/.env.example config/.env

# ─── Gmail ────────────────────────────────────────────────────────────────────
# Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호에서 발급
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── 텔레그램 봇 (선택) ────────────────────────────────────────────────────────
# 1. 텔레그램에서 @BotFather 에게 /newbot 명령으로 봇 생성
# 2. 발급받은 토큰을 TELEGRAM_BOT_TOKEN 에 입력
# 3. TELEGRAM_CHAT_ID: 본인 채팅 ID (https://t.me/userinfobot 에서 확인)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# ─── Google Drive (선택) ───────────────────────────────────────────────────────
# Google Drive 앱 설치 시 로컬 동기화 폴더 경로
# Mac: /Users/yourname/Library/CloudStorage/GoogleDrive-your@gmail.com
# Windows: C:\Users\yourname\Google Drive
GOOGLE_DRIVE_PATH=/Users/yourname/Library/CloudStorage/GoogleDrive-your@gmail.com

# ─── Picovoice 웨이크워드 ─────────────────────────────────────────────────────
# 1. https://console.picovoice.ai 에서 무료 계정 생성 후 Access Key 발급
# 2. Porcupine > 커스텀 웨이크워드 생성 (한국어, 플랫폼에 맞게 선택)
#    - Mac ARM (M1~M4): mac (arm64)
#    - Mac Intel:       mac (x86_64)
#    - Windows:         windows
# 3. 다운로드한 .ppn 파일 경로와 porcupine_params_ko.pv 경로 입력
PICOVOICE_ACCESS_KEY=your_picovoice_access_key
KEYWORD_PATH=/path/to/your_wakeword_ko_mac.ppn
KO_MODEL_PATH=/path/to/porcupine_params_ko.pv
